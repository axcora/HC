---
layout: base.cax
---
<div class="overlay" id="overlay"></div>
<header class="header"><a href="/" class="logo"><span class="logo-mark">{{ hc.navbar.logo }}</span><span>{{ hc.navbar.title }}</span></a><nav class="nav">{% for item in hc.navbar.list %}<a href="{{ item.url }}">{{ item.name }}</a>{% endfor %}</nav><a href="{{ hc.navbar.button.url }}" class="btn btn-accent" target="_blank">{{ hc.navbar.button.text }}</a><button class="hamburger" id="hamburger"  aria-label="Open menu"><span></span></button></header>
<nav class="mobile-nav" id="mobileNav"><div class="mobile-nav-links">{% for item in hc.navbar.list %}<a href="{{ item.url }}">{{ item.name }} <em> {{item.no}} </em></a>{% endfor %}<a href="{{ hc.navbar.button.url }}" target="_blank">{{ hc.navbar.button.text }} <em>0{{ hc.navbar.list | length + 1 }}</em></a></div><div class="mobile-foot"><span>© 2026 {{ hc.navbar.title }}</span><span>Premium Themes That Convert</span></div></nav>
<section class="section">
  <div class="head">
    <h2 class="huge display">{{ hc.services.title }}<br><em>Escrow Protected</em></h2>
    <p class="mono">{{ hc.services.description }} - {{ hc.services.info }}</p>
  </div>
  <div class="services">
    {% for svc in hc.services.list %}
    <a class="svc" href="{{ svc.button.url }}" target="_blank" rel="noopener">
      <small>{{ svc.info }}</small>
      <h3>{{ svc.title }}</h3>
      <p>{{ svc.description }}</p>
      <span class="btn btn-paper">{{ svc.button.text }} -></span>
    </a>
    {% endfor %}
  </div>
</section>