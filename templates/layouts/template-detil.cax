---
layout: base.cax
---
<div class="overlay" id="overlay"></div>
<header class="header"><a href="/" class="logo"><span class="logo-mark">{{ hc.navbar.logo }}</span><span>{{ hc.navbar.title }}</span></a><nav class="nav"><a href="{{hc.navbar.template.url}}">← {{hc.navbar.template.text}}</a></nav><a href="{{ download }}" class="btn btn-accent" target="_blank">{{hc.navbar.template.button}}</a><button class="hamburger" id="hamburger" aria-label="Menu"><span></span></button></header>
<nav class="mobile-nav" id="mobileNav"><div class="mobile-nav-links">{% for n in hc.navbar.list %}<a href="{{n.url}}">{{n.name}} <em>{{n.no}}</em></a>{% endfor %}<a href="{{ download }}" target="_blank">{{hc.navbar.template.button}} <em>Code</em></a></div><div class="mobile-foot"><span>© 2026 {{ hc.navbar.title }}</span><span>Premium and Free Themes Template</span></div></nav>
<style>
.detail-wrap{display:flex;flex-direction:column;gap:24px}
.detail-left{width:100%;min-width:0}
.detail-right{width:100%}
.media-box img{width:100%;height:auto;display:block;aspect-ratio:800/600}
.tabs{display:flex;gap:8px;padding:5px;overflow-x:auto;white-space:nowrap;padding-bottom:8px;-webkit-overflow-scrolling:touch}
.tabs button{flex-shrink:0;padding:10px 16px;border-radius:8px;border:1px solid #000;background:#fff;color:#000}
.tabs button.active{background:#000;color:#fff}
.panel{display:none;width:100%}
.panel.active{display:block}
ol,ul{margin-left:20px;padding-left:15px}
pre{background:#000;color:#fff;padding:16px;border-radius:8px;overflow:auto}
pre code{background:0 0;color:inherit;padding:0}
code{background:#000;color:#fff;padding:2px 6px;border-radius:4px}
.form-control{width:100%;box-sizing:border-box}
.kv dd{word-break:break-all}
#gumroadContent{width:100%;min-width:0}
#gumroadContent figure{margin:20px 0;width:100%;max-width:100%;display:block}
#gumroadContent img{max-width:100%;height:auto;display:block;border-radius:12px;background:#111}
#gumroadContent.tiptap__raw{margin:20px 0;width:100%;aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden;position:relative;display:block}
#gumroadContent div[style*="padding-bottom"]{width:100%!important;aspect-ratio:16/9!important;height:auto!important;position:relative!important;padding-bottom:0!important}
.lite-yt{position:absolute;inset:0;width:100%;height:100%;cursor:pointer;background:#000}
.lite-yt img{width:100%;height:100%;object-fit:cover;display:block}
.lty-play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:68px;height:48px;background:#f00;border-radius:12px;border:0}
.lty-play::before{content:'';position:absolute;left:50%;top:50%;transform:translate(-40%,-50%);border-left:18px solid #fff;border-top:11px solid transparent;border-bottom:11px solid transparent}
.figcaption:empty{display:none}
@media(min-width:1024px){.detail-wrap{flex-direction:row;align-items:flex-start}.detail-left{flex:1;min-width:0}.detail-right{width:380px;position:sticky;top:84px;height:fit-content}}
</style>
<section class="section"><div class="detail-wrap"><div class="detail-left">
<p class="mono" style="word-break:break-all">{% for tag in tags %}<a href="/tags/{{tag}}">{{tag}}</a>  {% endfor %}</p>
<h1 class="display mt-12" style="word-break:break-word">{{ title }}<br><em class="serif" style="display:block;font-size:0.6em;line-height:1.3">{{ description }}</em></h1>
<div class="media-box mt-16"><img class="img-fluid p-3 brun sc" alt="{{ description }}" width="800" height="600" src="{{ image }}" decoding="async" fetchpriority="high"></div>
<div class="tabs mt-20" id="tabs"><button class="active" data-tab="f">Features</button><button data-tab="s">Share</button><button data-tab="l">License</button></div>
<div class="panel active" data-panel="f"><h3>{{ title }}</h3><ul style="padding-left:18px">{% for feature in features %}<li style="margin-bottom:6px">{{ feature }}</li>{% endfor %}</ul><div class="mt-16" id="gumroadContent" style="word-break:break-word">{{ content }}</div></div>
<div class="panel" data-panel="s"><p>URL: {{hc.url}}{{url}}</p><input type="text" id="copyUrl" value="{{hc.url}}{{url}}" readonly class="form-control" style="padding:12px;background:#111;color:#fff;border:1px solid #555;border-radius:8px"><button onclick="copyUrl()" class="btn btn-accent w-full mt-12" style="color:#fff;width:100%;padding:12px;border-radius:8px">Copy URL</button><p class="mt-16">Embed — WSRV</p><input type="text" id="copyEmbed" value="<a href='{{hc.url}}{{url}}'><img src='{{ image }}' alt='{{ title }}'></a>" readonly class="form-control" style="padding:12px;background:#111;color:#fff;border:1px solid #555;border-radius:8px"><button onclick="copyEmbed()" class="btn btn-accent w-full mt-12" style="color:#fff;width:100%;padding:12px;border-radius:8px">Copy Embed</button><div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:16px"><a href="https://www.facebook.com/sharer/sharer.php?u={{hc.url}}{{url}}" target="_blank" style="flex:1 1 100px;background:#000;color:#fff;padding:12px;text-align:center;border-radius:8px;text-decoration:none;border:1px solid #fff">Facebook</a><a href="https://twitter.com/intent/tweet?text={{ title }}&url={{hc.url}}{{url}}" target="_blank" style="flex:1 1 100px;background:#000;color:#fff;padding:12px;text-align:center;border-radius:8px;text-decoration:none;border:1px solid #fff">Twitter</a><a href="https://api.whatsapp.com/send?text={{hc.url}}{{url}}" target="_blank" style="flex:1 1 100px;background:#000;color:#fff;padding:12px;text-align:center;border-radius:8px;text-decoration:none;border:1px solid #fff">WhatsApp</a><a href="https://pinterest.com/pin/create/button/?url={{hc.url}}{{url}}" target="_blank" style="flex:1 1 100px;background:#000;color:#fff;padding:12px;text-align:center;border-radius:8px;text-decoration:none;border:1px solid #fff">Pinterest</a></div></div>
<div class="panel" data-panel="l"><p><strong>{{ title }}</strong></p><p style="word-break:break-all">{{hc.url}}{{url}}</p><a href="{{ download }}" class="btn btn-accent w-full mt-12" target="_blank" style="display:block;text-align:center;padding:14px;border-radius:8px">GET NOW →</a></div>
</div>
<div class="detail-right"><div class="card" style="width:100%;box-sizing:border-box"><p class="mono">Own 100%</p><b class="display" style="font-size:20px;word-break:break-word">{{ title }}</b><p class="hint">{% for tag in tags %}<a href="/tags/{{tag}}">{{tag}}</a> {% endfor %}
</p><a href="{{ download }}" class="btn btn-accent w-full mt-12" target="_blank" style="display:block;text-align:center;padding:14px;border-radius:8px">DOWNLOAD →</a><hr/><p class="mono">Need Custom?</p><h4 class="display">Hire via Fiverr Escrow</h4><p class="hint">72+ verified reviews, escrow protected.</p><a href="https://www.fiverr.com/creativitas/create-your-custom-website-and-app" target="_blank" class="btn w-full mt-12">ORDER CUSTOM →</a><hr/><p class="mono mt-6">Update Template</p><p class="mono">{% if prev_link %}<span class="btn btn-paper w-full mt-12">{{ prev_link }}</span>{% endif %}{% if next_link %}<span class="btn btn-paper w-full mt-12">{{ next_link }}</span>{% endif %}</p></div></div></div></section>
<div id="toast" style="position:fixed;bottom:20px;left:10px;right:10px;background:#000;color:#fff;padding:14px;border-radius:10px;display:none;z-index:9999;text-align:center"></div>
{% include widget/featured.cax %}
{% include widget/services.cax %}

<script>
document.querySelectorAll('#tabs button').forEach(b=>{b.addEventListener('click',()=>{document.querySelectorAll('#tabs button').forEach(x=>x.classList.remove('active'));document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.querySelector('.panel[data-panel="'+b.dataset.tab+'"]')?.classList.add('active')})});
var h=document.getElementById('hamburger'),m=document.getElementById('mobileNav'),o=document.getElementById('overlay');h&&h.addEventListener('click',()=>{m.classList.toggle('active');o.classList.toggle('active')});
function toast(s){var t=document.getElementById('toast');t.textContent=s;t.style.display='block';setTimeout(()=>t.style.display='none',2000)}
function copyUrl(){navigator.clipboard.writeText(document.getElementById('copyUrl').value).then(()=>toast('URL Copied'))}
function copyEmbed(){navigator.clipboard.writeText(document.getElementById('copyEmbed').value).then(()=>toast('Embed Copied'))}
(()=>{const c=document.getElementById('gumroadContent');if(!c)return;
const tw=document.createTreeWalker(c,NodeFilter.SHOW_TEXT);let n;const del=[];while(n=tw.nextNode()){if(n.nodeValue.includes('raw>')){n.nodeValue=n.nodeValue.replace(/raw>?/gi,'');if(!n.nodeValue.trim())del.push(n)}}del.forEach(x=>x.parentNode&&x.parentNode.removeChild(x));
c.querySelectorAll('em').forEach(em=>{if(em.textContent.includes(';'))em.remove()});
c.querySelectorAll('iframe').forEach(f=>{
  let src=f.getAttribute('src')||'';
  let id=null;
  try{const u=new URL(src,location.href);let p=u.searchParams.get('url');if(p){p=decodeURIComponent(p);let m=p.match(/(?:youtu\.be\/|v=|embed\/)([A-Za-z0-9_-]{11})/);if(m)id=m[1]}}catch(e){}
  if(!id){let m=src.match(/([A-Za-z0-9_-]{11})/);if(m)id=m[1]}
  if(!id)return;
  const b=document.createElement('div');
  b.className='tiptap__raw';
  b.style.cssText='width:100%;aspect-ratio:16/9;background:#000;border-radius:12px;overflow:hidden;position:relative;display:block;margin:20px 0';
  b.innerHTML=`<div class="lite-yt" style="position:absolute;inset:0;width:100%;height:100%;cursor:pointer;background:#000"><img src="https://i.ytimg.com/vi/${id}/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/${id}/hqdefault.jpg'" loading="lazy" decoding="async" style="width:100%;height:100%;object-fit:cover;display:block" alt=""><button class="lty-play" aria-label="Play"></button></div>`;
  b.firstChild.onclick=()=>{
    const fr=document.createElement('iframe');
    fr.src='https://www.youtube.com/embed/'+id+'?autoplay=1&rel=0';
    fr.style.cssText='position:absolute;inset:0;width:100%;height:100%;border:0';
    fr.allowFullscreen=true;fr.setAttribute('allow','autoplay;encrypted-media');
    b.innerHTML='';b.appendChild(fr);
  };
  let target=f.closest('.tiptap__raw')||f.parentElement;
  if(target&&target.parentElement&&target.parentElement!==c&&!target.parentElement.matches('figure')){
    if(target.parentElement.querySelectorAll('iframe').length===1) target=target.parentElement;
  }
  if(target&&target.closest('figure')) target=target.closest('figure');
  target.replaceWith(b);
});
})();
</script>