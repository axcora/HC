<section class="section">
  <div class="head">
    <h2 class="huge display">{{ hc.services.title }}<br><em>Escrow Protected</em></h2>
    <p class="mono">{{ hc.services.description }} - {{ hc.services.info }}</p>
  </div>
  <div class="services">
    {% for svc in hc.services.list %}
    <a class="svc" href="{{ svc.button.url }}" target="_blank">
      <small>{{ svc.info }}</small>
      <h3>{{ svc.title }}</h3>
      <p>{{ svc.description }}</p>
      <span class="btn btn-paper">{{ svc.button.text }} -></span>
    </a>
    {% endfor %}
    <a class="svc" href="https://www.fiverr.com/creativitas" target="_blank">
      <small>12 - Full Catalog</small>
      <h3>View All Verified Gigs - Escrow Protected</h3>
      <p>Audit all deliveries on Fiverr..</p>
      <span class="btn">AUDIT ON FIVERR -></span>
    </a>
  </div>
</section>