<section class="section">
  <div class="head">
    <h2 class="huge display">{{ hc.themes.title }}<br><em>{{ hc.themes.description }}</em></h2>
    <div class="badge-row">
      <input id="q" class="input" placeholder="{{ hc.themes.search }}" aria-label="Search themes">
      <a href="{{ hc.themes.button.url }}" class="btn btn-paper">{{ hc.themes.button.text }} -></a>
    </div>
   <div class="stack-buttons" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:20px;">
  {% for s in hc.stacks %}
    <a href="{{ s.url }}" class="tag">{{ s.name }}</a>
  {% endfor %}
</div>
  </div>
  <div class="grid-themes">
  <a href="{{ hc.widget.url }}" class="card" target="_blank" rel="noopener">
  <h2 class="name display">{{ hc.widget.title }}<br><span>{{ hc.widget.text }}</span></h2>
  <div class="thumb">
    <img src="https://res.cloudinary.com/hockeycorp/image/upload/w_334/q_auto:low/f_avif/v1699871939/website%20design/{{ hc.cover }}" alt="{{ hc.widget.title }}" class="coveris" width="334" height="251" decoding="async" loading="eager" fetchpriority="high">
  </div>
  <div class="meta-tags">
    <span class="tag">{{ hc.widget.tag1 }}</span>
    <span class="tag">{{ hc.widget.tag2 }}</span>
    <span class="tag">{{ hc.widget.tag3 }}</span>
  </div>
  <div class="price-row"><span class="mono">{{ hc.widget.label }}</span><b>{{ hc.widget.price }}</b></div>
</a>
    {% for theme in featured_themes | limit(11) %}
      <a href="{{ theme.url }}" class="card">
        <h3 class="name display">{{ theme.title }}<br><span>{{ theme.description }}</span></h3>
        <div class="thumb"><div class="thumb-inner"><img src="https://res.cloudinary.com/hockeycorp/image/upload/w_334/q_auto:low/f_avif/v1699871939/website%20design/{{ theme.image or hc.cover }}" alt="{{ theme.title }}" loading="lazy" 
        width="334"
        height="251"
        decoding="async"/></div></div>
        <!--<div class="meta-tags">
          {% for tag in theme.tags | limit(2) %}
            <span class="tag">{{ tag }}</span>
          {% endfor %}
        </div>-->
      </a>
    {% endfor %}
  </div>
</section>