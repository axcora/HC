<section class="section">
  <div class="head">
    <h2 class="huge display">{{ hc.themes.title }}<br><em>{{ hc.themes.description }}</em></h2>
    <div class="badge-row">
      <input id="q" class="input" placeholder="{{ hc.themes.search }}" aria-label="Search themes">
      <a href="{{ hc.themes.button.url }}" class="btn btn-paper">{{ hc.themes.button.text }} -></a>
    </div>
   <div class="stack-buttons" style="display:flex;flex-wrap:wrap;gap:8px;margin-top:20px;">
  {% for s in hc.stacks %}
    <a href="{{ s.url }}" class="tag">{{ s.name }}</a>
  {% endfor %}
</div>
  </div>
  <div class="grid-themes">
    {% for theme in featured_themes | limit(12) %}
      <a href="{{ theme.url }}" class="card">
        <h3 class="name display">{{ theme.title }}<br><span>{{ theme.description }}</span></h3>
        <div class="thumb"><div class="thumb-inner"><img src="https://res.cloudinary.com/hockeycorp/image/upload/w_500/q_auto:low/f_avif/v1699871939/website%20design/{{ theme.image or hc.cover }}" alt="{{ theme.title }}" loading="lazy" width="100%" height="100%"/></div></div>
        <!--<div class="meta-tags">
          {% for tag in theme.tags | limit(2) %}
            <span class="tag">{{ tag }}</span>
          {% endfor %}
        </div>-->
      </a>
    {% endfor %}
  </div>
</section>