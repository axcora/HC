  <style>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Instrument+Serif:ital@0;1&family=Syne:wght@600;700;800&display=swap');
:root{--bg:#FFFBF8;--ink:#111;--paper:#fff;--accent:#FF2D30;--line:#111;--b:3px solid var(--line);--b2:2px solid var(--line);--max:1440px;--muted:#666}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:'Syne',system-ui,sans-serif;line-height:1.2;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}img{max-width:100%;height:auto;display:block}
.mono{font-family:ui-monospace,monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase}
.display{font-family:'Bebas Neue',sans-serif;line-height:.82;letter-spacing:.01em}
.serif{font-family:'Instrument Serif',serif}
/* HEADER PREMIUM */
.header{position:sticky;top:0;z-index:100;background:rgba(255,251,248,.92);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border-bottom:var(--b);display:flex;justify-content:space-between;align-items:center;padding:14px 20px}
.logo{font-weight:800;display:flex;gap:12px;align-items:center;z-index:101}.logo-mark{width:36px;height:36px;background:var(--accent);color:#fff;display:grid;place-items:center;font-family:'Bebas Neue';font-size:20px;border:2px solid var(--line)}
.nav{display:flex;gap:28px;align-items:center}
.nav a{font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;position:relative}
.nav a::after{content:'';position:absolute;left:0;bottom:-4px;width:0;height:2px;background:var(--accent);transition:.25s}
.nav a:hover::after{width:100%}
.btn{border:var(--b);background:var(--ink);color:#fff;padding:13px 20px;font-weight:800;font-size:11px;letter-spacing:.14em;text-transform:uppercase;display:inline-flex;justify-content:center;align-items:center;cursor:pointer;transition:.15s}
.btn:hover{transform:translate(-2px,-2px);box-shadow:4px 4px 0 var(--ink)}
.btn-accent{background:var(--accent);color:#fff}.btn-paper{background:var(--paper);color:var(--ink)}
/* HAMBURGER PREMIUM */
.hamburger{display:none;width:44px;height:44px;border:var(--b2);background:var(--paper);align-items:center;justify-content:center;cursor:pointer;z-index:101;position:relative}
.hamburger span{width:18px;height:2px;background:var(--ink);display:block;position:relative;transition:.25s}
.hamburger span::before,.hamburger span::after{content:'';position:absolute;left:0;width:18px;height:2px;background:var(--ink);transition:.25s}
.hamburger span::before{top:-6px}.hamburger span::after{top:6px}
.hamburger.active span{background:transparent}
.hamburger.active span::before{transform:rotate(45deg);top:0}
.hamburger.active span::after{transform:rotate(-45deg);top:0}
/* MOBILE MENU AWWWARDS STYLE */
.mobile-nav{position:fixed;inset:0;background:var(--bg);z-index:99;transform:translateX(100%);transition:transform .45s cubic-bezier(.85,0,.15,1);display:flex;flex-direction:column;padding:90px 24px 24px;border-left:var(--b)}
.mobile-nav.open{transform:translateX(0)}
.mobile-nav-links{display:flex;flex-direction:column;gap:0}
.mobile-nav-links a{font-family:'Bebas Neue';font-size:52px;line-height:.9;padding:14px 0;border-bottom:2px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.mobile-nav-links a em{font-family:'Instrument Serif';font-style:italic;font-size:28px;text-transform:lowercase;opacity:.6}
.mobile-nav-links a:hover{color:var(--accent)}
.mobile-foot{margin-top:auto;border-top:var(--b);padding-top:18px;display:flex;justify-content:space-between;font-size:11px;font-weight:700;text-transform:uppercase}
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:98;opacity:0;pointer-events:none;transition:.3s}
.overlay.show{opacity:1;pointer-events:auto}
/* HERO */
.hero{max-width:var(--max);margin:0 auto;padding:28px 20px 0;border-bottom:var(--b)}
.hero-title{font-size:clamp(56px,13vw,168px);line-height:.84}
.hero-title em{font-family:'Instrument Serif';font-style:italic;font-weight:400;display:block}
.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:20px;border-top:var(--b);margin-top:20px;padding:20px 0 28px}
.hero-desc{font-size:19px;line-height:1.5;max-width:54ch}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.stat{border:var(--b2);background:var(--paper);padding:12px}
.stat b{display:block;font-family:'Bebas Neue';font-size:26px}
.section{max-width:var(--max);margin:0 auto;padding:44px 20px;border-bottom:var(--b)}
.head{display:flex;justify-content:space-between;align-items:end;flex-wrap:wrap;gap:14px;margin-bottom:24px}
.huge{font-size:clamp(36px,6.8vw,88px);line-height:.9}
.huge em{font-family:'Instrument Serif';font-style:italic;font-weight:400}
.grid-themes{border:var(--b);display:grid;grid-template-columns:repeat(3,1fr);background:var(--line)}
.card{background:var(--paper);padding:18px;display:flex;flex-direction:column;gap:12px;min-height:420px;transition:.15s}
.card:hover{background:var(--accent);color:#fff}
.card:hover .tag{background:var(--paper);color:var(--ink)}
.top{display:flex;justify-content:space-between}
.tag{border:var(--b2);padding:4px 7px;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;background:var(--paper);color:var(--ink)}
.name{font-size:34px;line-height:.9}
.name span{display:block;font-family:'Instrument Serif';font-style:italic;font-size:28px;font-weight:400;margin-top:2px}
.thumb{border:var(--b2);aspect-ratio:16/10;background:#eee;overflow:hidden}
.thumb-inner{width:100%;height:100%;display:grid;place-items:center;font-family:'Bebas Neue';font-size:44px;background:repeating-linear-gradient(45deg,#111 0 2px,var(--accent) 2px 8px);color:#fff}
.thumb img{width:100%;height:100%;object-fit:cover}
.meta-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto}
.price-row{margin-top:auto;border-top:var(--b2);padding-top:10px;display:flex;justify-content:space-between;align-items:center}
.price-row b{font-family:'Bebas Neue';font-size:26px}
.pag{display:flex;border:var(--b);width:fit-content;margin-top:20px}
.pag a{padding:10px 16px;border-right:var(--b2);background:var(--paper);font-weight:800;font-size:11px}
.pag a.active{background:var(--ink);color:#fff}
.detail-wrap{border:var(--b);display:grid;grid-template-columns:1.1fr .9fr;background:var(--line)}
.detail-left{background:var(--paper);padding:22px}
.detail-right{background:var(--bg);padding:22px;border-left:var(--b)}
.kv-list{margin-top:12px}
.kv{display:grid;grid-template-columns:120px 1fr;gap:8px;padding:9px 0;border-bottom:1px dashed #bbb;font-size:13px}
.kv dt{font-weight:800;font-size:10px;letter-spacing:.12em;text-transform:uppercase}
.tabs{display:flex;border:var(--b);margin-top:18px}
.tabs button{flex:1;padding:12px;background:var(--paper);border:0;border-right:var(--b2);font-weight:800;font-size:10px;letter-spacing:.12em;text-transform:uppercase;cursor:pointer}
.tabs button.active{background:var(--ink);color:#fff}
.panel{display:none;padding:18px;border:var(--b);border-top:0;background:var(--paper);line-height:1.7;font-size:14px}
.panel.active{display:block}
.panel ul{padding-left:18px;margin:10px 0;list-style:disc}
.services{border:var(--b);display:grid;grid-template-columns:repeat(3,1fr);background:var(--line)}
.svc{background:var(--paper);padding:18px;min-height:260px;display:flex;flex-direction:column;gap:10px}
.svc:hover{background:var(--accent);color:#fff}
.svc:hover p{color:#fff}
.svc small{font-weight:800;letter-spacing:.14em;font-size:10px}
.svc h4{font-size:20px;line-height:.95;min-height:48px}
.svc p{font-size:12px;line-height:1.5;color:var(--muted)}
.svc .btn{margin-top:auto}
.sell{display:grid;grid-template-columns:.9fr 1.1fr;gap:32px}
.sell p{font-size:16px;line-height:1.7;margin:10px 0}
.lead{font-size:clamp(22px,3vw,30px);line-height:1.15;font-weight:800}
.check{display:flex;gap:8px;margin:10px 0;align-items:start}
.check i{width:22px;height:22px;border:2px solid var(--line);background:var(--accent);color:#fff;display:grid;place-items:center;font-style:normal;font-weight:900;flex:0 0 22px;font-size:12px;margin-top:2px}
.input{width:100%;border:var(--b2);padding:12px 14px;background:var(--paper);font-family:inherit;font-size:14px}
.footer{padding:18px 20px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;border-top:var(--b);font-size:11px;font-weight:700;text-transform:uppercase}
.media-box{border:var(--b2);background:var(--paper);aspect-ratio:16/10;overflow:hidden}
.media-box img{width:100%;height:100%;object-fit:cover}
.lite-yt{position:relative;width:100%;aspect-ratio:16/9;border:var(--b2);background:#000;cursor:pointer;overflow:hidden}
.lite-yt img{width:100%;height:100%;object-fit:cover;opacity:.85}
.lite-yt .play{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:68px;height:48px;background:var(--accent);border:var(--b2);display:grid;place-items:center;font-weight:900;color:#fff}
.lite-yt .play::after{content:'▶';font-size:20px;margin-left:2px}
.badge-row{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.hint{font-size:12px;color:var(--muted);line-height:1.5;margin-top:8px}
.mt-8{margin-top:8px}.mt-12{margin-top:12px}.mt-16{margin-top:16px}.mt-20{margin-top:20px}.mt-24{margin-top:24px}
.w-full{width:100%}.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.code-block{background:#111;color:#fff;padding:12px;overflow:auto;font-size:12px;line-height:1.5;font-family:ui-monospace,monospace;border:var(--b)}
#formOut{display:none}.hidden{display:none}
.coveris {width:100%;height:220px;object-fit:cover;}
@media(max-width:1024px){.hero-grid,.detail-wrap,.sell{grid-template-columns:1fr}.grid-themes{grid-template-columns:repeat(2,1fr)}.services{grid-template-columns:repeat(2,1fr)}.detail-right{border-left:0;border-top:var(--b)}}
@media(max-width:768px){
  .nav,.header .btn-accent{display:none}
  .hamburger{display:flex}
  .hero-title{font-size:52px}
  .mobile-nav{width:86%;left:auto;right:0}
  .grid-themes,.services{grid-template-columns:1fr}
  .grid-2{grid-template-columns:1fr}
  .head{flex-direction:column;align-items:start}
  .section{padding:28px 16px}
  .header{padding:12px 16px}
}
@media(max-width:480px){.mobile-nav-links a{font-size:40px}.stats{grid-template-columns:1fr}}
  </style>