<section class="section">
  <div class="head">
    <h2 class="huge display">{{ hc.themes.title }}<br><em>{{ hc.themes.description }}</em></h2>
    <div class="badge-row">
      <a href="{{ hc.themes.button.url }}" class="btn btn-paper">{{ hc.themes.button.text }} -></a>
    </div>
  </div>
  <div class="grid-themes">
    {% for theme in collections.featured_themes | limit(3) %}
      <a href="{{ theme.url }}" class="card">
        <h3 class="name display">{{ theme.title }}<br><span>{{ theme.stack }}</span></h3>
        <div class="thumb"><div class="thumb-inner">
          <img src="https://res.cloudinary.com/hockeycorp/image/upload/w_500/q_auto:low/f_avif/v1699871939/website%20design/{{ theme.image }}" width="100%" height="100%" alt="{{ theme.title }}" loading="lazy" style="width:100%;height:220px;object-fit:cover;">
        </div></div>
        <div class="meta-tags">
          {% for tag in theme.tags | limit(2) %}
            <span class="tag">{{ tag }}</span>
          {% endfor %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>