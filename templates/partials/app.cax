<script>
document.addEventListener('DOMContentLoaded',()=>{
  const ham=document.getElementById('hamburger');
  const mNav=document.getElementById('mobileNav');
  const overlay=document.getElementById('overlay');
  function toggleMenu(){
    const open=mNav.classList.contains('open');
    if(open){
      mNav.classList.remove('open');overlay.classList.remove('show');ham.classList.remove('active');document.body.style.overflow='';
    }else{
      mNav.classList.add('open');overlay.classList.add('show');ham.classList.add('active');document.body.style.overflow='hidden';
    }
  }
  ham.addEventListener('click',toggleMenu);
  overlay.addEventListener('click',toggleMenu);
  mNav.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{mNav.classList.remove('open');overlay.classList.remove('show');ham.classList.remove('active');document.body.style.overflow='';}));

  document.querySelectorAll('[data-tabs]').forEach(w=>{
    const btns=w.querySelectorAll('[data-tab]');const panels=document.querySelectorAll('[data-panel]');
    btns.forEach(b=>b.addEventListener('click',()=>{btns.forEach(x=>x.classList.remove('active'));b.classList.add('active');panels.forEach(p=>p.classList.toggle('active',p.dataset.panel===b.dataset.tab));}));
  });
  const q=document.getElementById('q');
  if(q) q.addEventListener('input',e=>{const v=e.target.value.toLowerCase();document.querySelectorAll('.card').forEach(c=>c.style.display=c.textContent.toLowerCase().includes(v)?'flex':'none');});
  document.querySelectorAll('[data-page]').forEach(a=>a.addEventListener('click',e=>{e.preventDefault();document.querySelectorAll('[data-page]').forEach(x=>x.classList.remove('active'));a.classList.add('active');}));
  document.querySelectorAll('.lite-yt').forEach(el=>{
    el.addEventListener('click',()=>{
      const id=el.dataset.id;
      el.innerHTML=`<iframe width="100%" height="100%" src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1" title="Demo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe>`;
    },{once:true});
  });
  const form=document.getElementById('contactForm');
  if(form) form.addEventListener('submit',e=>{
    e.preventDefault();
    const d=new FormData(form);
    const out=document.getElementById('formOut');
    out.style.display='block';
    out.innerHTML=`<p class="mono">Inquiry ready — copy & email:</p><p class="mt-12" style="white-space:pre-wrap;line-height:1.6">Interest: ${d.get('interest')}\nName: ${d.get('name')}\nEmail: ${d.get('email')}\n\nMessage: ${d.get('message')}</p><div class="mt-12"><a class="btn btn-accent" href="mailto:hello@hockeycomputindo.com?subject=Theme Inquiry - ${d.get('interest')}&body=${encodeURIComponent('Name: '+d.get('name')+'\nEmail: '+d.get('email')+'\n\n'+d.get('message'))}">SEND EMAIL</a></div>`;
  });
  const y=document.getElementById('year');if(y) y.textContent=new Date().getFullYear();
});
</script>