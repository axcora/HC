@echo off
setlocal
for /f "tokens=1,2 delims==" %%a in (.env) do if "%%a"=="GUMROAD_TOKEN" set TOKEN=%%b
echo FETCH GUMROAD -> content/template/
powershell -ExecutionPolicy Bypass -Command "[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $token='%TOKEN%'; $headers=@{'Authorization'='Bearer '+$token}; $outDir='content/template'; $cacheFile=\"$outDir/.gumroad_cache.json\"; $cache=@{}; if(Test-Path $cacheFile){try{$cache=Get-Content $cacheFile -Raw | ConvertFrom-Json -AsHashtable}catch{}}; $newCache=@{}; $all=@(); $k=$null; do{ $u='https://api.gumroad.com/v2/products'; if($k){$u+='?page_key='+$k}; $r=Invoke-RestMethod -Uri $u -Method GET -Headers $headers; $all+=$r.products; $k=$r.next_page_key }while($k); if(!(Test-Path $outDir)){New-Item -ItemType Directory -Path $outDir -Force|Out-Null}; $currentSlugs=@(); foreach($p in $all){ if($p.deleted){continue}; $slug=if($p.custom_permalink){$p.custom_permalink}else{$p.id}; $slug=$slug.ToLower() -replace '[^a-z0-9-]','-'; $currentSlugs+=$slug; $date=Get-Date -Format 'yyyy-MM-dd'; $desc=$p.custom_summary; if(-not $desc){$desc=$p.name}; $desc=$desc -replace '\"','' -replace '`',''; $safeName=$p.name -replace '\"','' -replace '`',''; $safeDesc=$p.description -replace '\"',''; $raw=$p.preview_url; if(-not $raw -and $p.custom_images){$raw=$p.custom_images[0]}; if(-not $raw){$raw=$p.thumbnail_url}; if(-not $raw){$raw=\"https://public-files.gumroad.com/$slug\"}; $priceD=[math]::Round($p.price/100,2); $priceT=if($priceD -eq 0){'Free'}else{$priceD}; $hashSrc=\"$($p.name)|$($p.price)|$raw|$($p.updated_at)\"; $hash=[BitConverter]::ToString([System.Security.Cryptography.MD5]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes($hashSrc))) -replace '-',''; $newCache[$slug]=$hash; $mdPath=\"$outDir/$slug.md\"; if($cache[$slug] -eq $hash -and (Test-Path $mdPath)){Write-Host \"SKIP $slug\"; continue}; $enc=[uri]::EscapeDataString($raw); $wsrv=\"https://wsrv.nl/?url=$enc&w=1200&output=webp&q=85&af=\"; $tagStr=\" - themes`n - template\"; if($p.tags){foreach($tg in $p.tags){$tagStr+=\"`n - $($tg -replace '\"','')\"}}; $md=\"---`ntitle: $safeName`ndescription: $desc`nimage: $wsrv`nimage_raw: $raw`ndownload: $($p.short_url)`nprice: $priceT`nprice_cents: $($p.price)`nsales: $($p.sales_count)`ntags:`n$tagStr`nlayout: template-detil.cax`ndate: $date`nupdated: $($p.updated_at)`n---`n`n$safeDesc`n\"; Set-Content -Path $mdPath -Value $md -Encoding UTF8; Write-Host \"UPDATE $slug = $priceT\" }; Get-ChildItem $outDir -Filter *.md | Where-Object { $currentSlugs -notcontains $_.BaseName } | ForEach-Object { Remove-Item $_.FullName -Force; Write-Host \"DELETE $($_.Name)\" }; $newCache | ConvertTo-Json | Set-Content -Path $cacheFile -Encoding UTF8; Write-Host \"DONE $($all.Count)\""
endlocal